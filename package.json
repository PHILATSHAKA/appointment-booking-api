{
	"name": "appointment-booking-api",
	"version": "0.0.0",
	"description": "Appointment booking api for customers to schedule branch appointments.",
	"author": "Phila Tshaka",
	"license": "UNLICENSED",
	"private": true,
	"main": "dist/src/app.js",
	"type": "module",
	"repository": {
		"type": "git",
		"url": "https://github.com/capitecbankltd/dmc-merchant-portal_permissions-api.git"
	},
	"homepage": "https://github.com/capitecbankltd/dmc-merchant-portal_permissions-api",
	"bugs": {
		"url": "https://github.com/capitecbankltd/dmc-merchant-portal_permissions-api/issues",
		"email": "nobody@email.com"
	},
	"engines": {
		"npm": ">=9",
		"node": "22.x"
	},
	"imports": {
		"#errors/*.js": "./src/errors/*.js",
		"#framework/*.js": "./src/framework/*.js",
		"#preHandlers/*.js": "./src/preHandlers/*.js",
		"#resources/*.js": "./src/resources/*.js",
		"#routes/*.js": "./src/routes/*.js",
		"#services/*.js": "./src/services/*.js",
		"#src/*.js": "./src/*.js",
		"#common/*.js": "./src/common/*.js",
		"#types/*.js": "./src/types/*.js",
		"#utils/*.js": "./src/utils/*.js"
	},
	"scripts": {
		"clean": "rimraf dist",
		"build": "npm run clean && tsc",
		"dev": "tsx watch src/app.js",
		"postbuild": "node tasks/buildCopyStaticContent.mjs",
		"start": "node dist/src/app.js",
		"lint": "eslint \"src/**/*.{js,ts,tsx}\"",
		"lint:fix": "eslint \"src/**/*.{js,ts,tsx}\" --fix",
		"spell": "cspell src/**/*.{js,ts,html,css,md,json} --no-progress",
		"api-contract": "npm run build && node tasks/generateApiContract.mjs",
		"lib-check": "npx npm-check-updates --interactive --format group",
		"prelocal-checks": "npm version patch --no-git-tag-version",
		"local-checks": "npm install && npm run lint && npm run spell && npm run build && npm run api-contract"
	},
	"dependencies": {
		"@fastify/autoload": "6.3.1",
		"@fastify/cors": "11.1.0",
		"@fastify/formbody": "8.0.2",
		"@fastify/helmet": "13.0.1",
		"@fastify/request-context": "6.2.1",
		"@fastify/static": "8.2.0",
		"@fastify/swagger": "9.5.1",
		"@fastify/swagger-ui": "5.2.3",
		"@instana/collector": "4.25.0",
		"axios": "1.12.2",
		"dayjs": "1.11.18",
		"fastify": "5.6.1",
		"fastify-type-provider-zod": "4.0.2",
		"fs-extra": "11.3.2",
		"jsonwebtoken": "9.0.2",
		"jwks-rsa": "3.2.0",
		"kafkajs": "2.2.4",
		"pg": "8.16.3",
		"pino": "9.11.0",
		"ts-jest": "29.4.4",
		"zod": "3.25.28"
	},
	"devDependencies": {
		"@eslint/js": "9.36.0",
		"@types/fs-extra": "11.0.4",
		"@types/jest": "30.0.0",
		"@types/jsonwebtoken": "9.0.10",
		"@types/node": "24.5.2",
		"@types/pg": "8.15.5",
		"@types/supertest": "6.0.3",
		"@typescript-eslint/eslint-plugin": "8.44.1",
		"@typescript-eslint/parser": "8.44.1",
		"@vitest/coverage-v8": "3.2.4",
		"cspell": "9.2.1",
		"dotenv": "17.2.2",
		"eslint": "9.36.0",
		"eslint-plugin-import": "2.32.0",
		"eslint-plugin-jsdoc": "60.3.1",
		"npm-check-updates": "18.3.0",
		"rimraf": "6.0.1",
		"run-script-os": "1.1.6",
		"supertest": "7.1.4",
		"typescript": "5.9.2",
		"vitest": "3.2.4",
		"yaml": "2.8.1"
	}
}
