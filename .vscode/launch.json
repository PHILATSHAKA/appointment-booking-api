{
	"version": "0.2.0",
	"configurations": [
		{
			"name": "Debug",
			"command": "npm start",
			"type": "node-terminal",
			"request": "launch",
			"preLaunchTask": "npm:build",
			"skipFiles": [
				"<node_internals>/**",
				"node_modules/**"
			],
			"env": {
				"NODE_EXTRA_CA_CERTS": "${workspaceFolder}/certs/CapitecRootCA.pem",
				"SERVICE_LOG_LEVEL": "info",
				"SECRETS_BASE_PATH": "${workspaceFolder}/secrets"
			},
			"envFile": "${workspaceFolder}/.env",
			"outFiles": [
				"${workspaceFolder}/dist/**/*.js",
				"!**/node_modules/**"
			]
		}
	]
}